@page "/heating"
@page "/"
@using MicrowaveCommander.Front.Components
@using MicrowaveCommander.Front.Models

<h3>Aquecimento</h3>
<EditForm EditContext="@editContext" OnValidSubmit="VerifyInput">
    <DataAnnotationsValidator />
    <div class="form-row">
        <div class="col-2 mb-3">
            <label>Minutos</label>
            <InputNumber inputmode="numeric" disabled="@presetSelected" id="minutes" min="0" max="2" class="form-control" @bind-value="heatingModel.Minutes"/>
        </div>
        <div class="col-2 mb-3">
            <label>Segundos</label>
            <InputNumber inputmode="numeric" disabled="@presetSelected" id="seconds" min="0" max="100" class="form-control" @bind-value="heatingModel.Seconds"/>
            <ValidationMessage For="() => heatingModel.Seconds"></ValidationMessage>
        </div>
        <div class="col-3 mb-3">
            <label>Potência</label>
            <InputNumber inputmode="numeric" disabled="@presetSelected" id="power" min="0" max="10" class="form-control" @bind-value="heatingModel.Power"/>
            
        </div>
        <div class="mt-3 mb-3">
            <button type="submit" disabled="@(presetSelected != null &&!TimerIsPaused())" class="btn btn-primary">Iniciar Aquecimento</button>
            <button type="button" class="btn btn-danger" @onclick="PauseStopHeating">Pausar/Parar</button>
        </div>
        <div class="mt-3 gap-3 mb-3">
            @foreach (var preset in BuildPresets())
            {
                <button type="button" class="btn btn-secondary" @onclick="@(() => StartPresets(preset))">@preset.Name</button>
            }
        </div>
        <div class="mt-3 mb-3">
            <h3>Timer: @(timer.RemainingMinutes.ToString().PadLeft(2, '0')):
                @(timer.RemainingSeconds.ToString().PadLeft(2, '0'))</h3>
        </div>
        <div class="mt-3 mb-3">
            <h3>Processing: @processing</h3>
        </div>
    </div>
</EditForm>

@code {
    
    private MicrowaveTimer timer = new(0, 0, TimerStatusEnum.Stopped);
    private HeatingModel heatingModel = new HeatingModel();
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private string processing = "";
    private string processingString = "";
    private ProgramPreset? presetSelected;

    protected override void OnInitialized()
    {
        editContext = new EditContext(heatingModel);
        messageStore = new ValidationMessageStore(editContext);

        editContext.OnFieldChanged += (sender, args) =>
        {
            messageStore.Clear();
            editContext.NotifyValidationStateChanged();
        };
    }
    
    private void VerifyInput()
    {
        if (editContext == null || messageStore == null) return;
        messageStore.Clear();

        if (ItIsFastInitialization())
        {
            StartHeating();
            return;
        }
        if (TimerIsStopped() && ValidateInput() ) return;
    
        StartHeating(heatingModel.Minutes.Value, 
            heatingModel.Seconds.Value, 
            heatingModel.Power.Value);
            
        _ = InvokeAsync(StateHasChanged);
    }
    
    private bool ValidateInput()
    {
        var secondsAmount = heatingModel.Minutes * 60 + heatingModel.Seconds;
        const int maxSeconds = 120;
        if (secondsAmount > maxSeconds )
        {
            var field = new FieldIdentifier(heatingModel, nameof(HeatingModel.Seconds));
            messageStore.Add(field, "O tempo de aquecimento deve ser de 2 minutos ou menos!");
            editContext.NotifyValidationStateChanged();
            return true;
        }
        if (secondsAmount <=  0)
        {
            var field = new FieldIdentifier(heatingModel, nameof(HeatingModel.Seconds));
            messageStore.Add(field, "O tempo de aquecimento deve ter pelo menos 1 segundo de duração!");
            editContext.NotifyValidationStateChanged();
            return true;
        }
        return false;
    }
    
    private void StartHeating(int minutes = 0, int seconds = 30, int power = 10, string pattern = ".")
    {
        switch (timer.Status)
        {
            case TimerStatusEnum.Running:
                timer.PauseTimer();
                timer.AddHeatingTime(0,30);
                timer.StartTimer(CreateDefaultTimer());
                break;
                
            case TimerStatusEnum.Paused:
                timer.StartTimer(CreateDefaultTimer());
                break;
                
            case TimerStatusEnum.Stopped:
                processing = "";
                processingString = GenerateProcessingString(power, pattern);
                timer.AddHeatingTime(minutes, seconds);
                timer.StartTimer(CreateDefaultTimer());
                break;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private void StartPresets(ProgramPreset preset)
    {
        presetSelected = preset;
        ResetTimer();
        heatingModel.Minutes = preset.TimeInSeconds /60;
        heatingModel.Seconds = preset.TimeInSeconds %60 ;
        heatingModel.Power = preset.Power;
        StartHeating(0, preset.TimeInSeconds, preset.Power, preset.ProcessingString);
    }

    private string GenerateProcessingString(int power, string pattern)
    {
        string fullPattern = "";
        for (int i = 0; i < power; i++)
        {
            fullPattern += pattern;
        }
        return fullPattern;
    }

    private void TimerCallback(object? state)
    {
        if (timer.RemainingSeconds > 0)
        {
            processing += processingString;
            processing += " ";
            timer.RemainingSeconds--;
        }
        else
        {
            if (timer.RemainingMinutes > 0)
            {
                processing += processingString;
                processing += " ";
                timer.RemainingMinutes--;
                timer.RemainingSeconds = 59;
            }
            if (timer.RemainingMinutes == 0 && timer.RemainingSeconds == 0)
            {
                timer.PauseTimer();
                processing += "Aquecimento concluído!";
            }
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private void ResetTimer()
    {
        timer.ResetTimer();
        processing = "";
        heatingModel = new();
    }

    private void PauseStopHeating()
    {
        if (TimerIsRunning())
            timer.PauseTimer();
        else
        {
            presetSelected = null;
            ResetTimer();
        }
    }

    private List<ProgramPreset> BuildPresets() => new List<ProgramPreset>()
    {
        new ProgramPreset()
        {
            Name = "Pipoca",
            Meal = "Pipoca (de micro-ondas)",
            TimeInMinutes = 3,
            TimeInSeconds = 183,
            Power = 7,
            Instructions = "Observar o barulho de estouros do milho, caso houver um intervalo de mais de 10 segundos entre um estouro e outro, interrompa o aquecimento.",
            ProcessingString = "p"
        },
        new ProgramPreset() { 
            Name = "Leite", 
            Meal = "Leite",
            TimeInMinutes = 5,
            TimeInSeconds = 300,
            Power = 5,
            Instructions = "Cuidado com aquecimento de líquidos, o choque térmico aliado ao movimento do recipiente pode causar fervura imediata causando risco de queimaduras.",
            ProcessingString = "l"
        },
        new ProgramPreset() { 
            Name = "Carnes de boi", 
            Meal = "Carne em pedaço ou fatias",
            TimeInMinutes = 14,
            TimeInSeconds = 840,
            Power = 4,
            Instructions = "Interrompa o processo na metade e vire o conteúdo com a parte de baixo para cima para o descongelamento uniforme.",
            ProcessingString = "c"
        },
        new ProgramPreset() { 
            Name = "Frango", 
            Meal = "Frango (qualquer corte)",
            TimeInMinutes = 8,
            TimeInSeconds = 480,
            Power = 7,
            Instructions = "Interrompa o processo na metade e vire o conteúdo com a parte de baixo para cima para o descongelamento uniforme.",
            ProcessingString = "f"
        },
        new ProgramPreset() { 
            Name = "Feijão", 
            Meal = "Feijão congelado",
            TimeInMinutes = 8,
            TimeInSeconds = 480,
            Power = 9,
            Instructions = "Interrompa o processo na metade e vire o conteúdo com a parte de baixo para cima para o descongelamento uniforme.",
            ProcessingString = "j"
        },
    };
    
    private bool TimerIsRunning() => timer.Status.Equals(TimerStatusEnum.Running);
    private bool TimerIsPaused() => timer.Status.Equals(TimerStatusEnum.Paused);
    private bool TimerIsStopped() => timer.Status.Equals(TimerStatusEnum.Stopped);
    
    private bool ItIsFastInitialization() => heatingModel.Minutes is null
                                             || heatingModel.Seconds is null
                                             || heatingModel.Power is null;
    
    private Timer CreateDefaultTimer() => new(TimerCallback, null, 1000, 1000);
}